{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "data",
    "source": "     $1/\\\n    $1/  \\\n   $1/    \\\n  $1/------\\\n $1/        \\\n$1/          \\",
    "color": {
      "1": "38;2;156;206;106"
    },
    "padding": {
      "top": 0,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "separator": "38;2;156;206;106"
    }
  },
  "modules": [
    {
      "key": " ",
      "type": "colors",
      "symbol": "circle",
      "keyColor": "38;2;117;189;187"
    },
    {
      "type": "os",
      "key": " ",
      "keyColor": "38;2;117;189;187",
      "format": "{name} {version-id}"
    },
    {
      "type": "command",
      "key": " ",
      "keyColor": "38;2;117;189;187",
      "text": "echo Linux $(uname -r | cut -d. -f1)"
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "38;2;117;189;187"
    },
    {
      "type": "wm",
      "key": " ",
      "keyColor": "38;2;117;189;187"
    },
    {
      "type": "cpu",
      "format": "{1}",
      "key": " ",
      "keyColor": "38;2;117;189;187"
    },
    {
      "type": "disk",
      "key": " ",
      "keyColor": "38;2;117;189;187",
      "format": "{size-total}"
    }
  ]
}
