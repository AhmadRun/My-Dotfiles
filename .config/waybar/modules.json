{
  "custom/cava-internal": {
    "exec": "sh ~/.config/waybar/scripts/Cava.sh",
    "format": "{}",
    "tooltip": false,
    "on-click": "",
    "layer": "below",
    "output": "all"
  },
  "idle_inhibitor": {
    "format": "<span font_family='JetBrainsMono Nerd Font Mono' font='14px'>{icon}</span>",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰾪"
    }
  },
  "tray": {
    "spacing": 5,
    "icon-size": 16
  },
  "clock": {
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#bb9af7'><b>{}</b></span>",
        "days": "<span color='#7aa2f7'><b>{}</b></span>",
        "weeks": "<span color='#9ece6a'><b>W{}</b></span>",
        "weekdays": "<span color='#e0af68'><b>{}</b></span>",
        "today": "<span background='#2ac3de' color='#1a1b26'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    },
    "format": "{:%a %d %b | %I:%M %p}",
    "format-alt": "{:%Y-%m-%d  %H:%M:%S}",
    "interval": 1
  },
  "custom/system": {
    "format": "<span font_family='JetBrainsMono Nerd Font Mono' font='14px'>󰍹</span>",
    "tooltip": false
  },
  "cpu": {
    "format": "<span font_family='JetBrainsMono Nerd Font Mono' font='14px'>󰍛</span> {usage}%",
    "on-click": "kitty -e btop"
  },
  "memory": {
    "format": "<span font_family='JetBrainsMono Nerd Font Mono' font='14px'>󰘚</span> {}%",
    "on-click": "kitty -e btop"
  },
  "temperature": {
    "thermal-zone": 5,
    "critical-threshold": 80,
    "format": "<span font_family='JetBrainsMono Nerd Font Mono' font='14px'>󰔏</span> {temperatureC}°C"
  },
  "disk": {
    "format": "<span font_family='JetBrainsMono Nerd Font Mono' font='14px'>󰋊</span> {percentage_used}%",
    "path": "/"
  },
  "group/hardware": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "children-class": "not-memory",
      "transition-left-to-right": false
    },
    "modules": [
      "custom/system",
      "disk",
      "cpu",
      "memory"
    ]
  },
  "backlight": {
    "format": "<span font_family='JetBrainsMono Nerd Font Mono' font='14px'>{icon}</span> {percent}%",
    "format-icons": [
      "󰃞",
      "󰃟",
      "󰃠"
    ],
    "on-scroll-down": "brightnessctl -c backlight set 5%-",
    "on-scroll-up": "brightnessctl -c backlight set +5%",
    "on-click": ""
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "<span font_family='JetBrainsMono Nerd Font Mono' font='14px'>{icon}</span> {capacity}%",
    "format-charging": "<span font_family='JetBrainsMono Nerd Font Mono' font='14px'>󰂄</span> {capacity}%",
    "format-plugged": "<span font_family='JetBrainsMono Nerd Font Mono' font='14px'>󰚥</span> {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁼",
      "󰁾",
      "󰂀",
      "󰁹"
    ],
    "on-click": "~/.config/waybar/scripts/battery-menu.sh"
  },
  "network": {
    "format": "<span font_family='JetBrainsMono Nerd Font Mono' font='14px'>󰤭</span>",
    "format-wifi": "<span font_family='JetBrainsMono Nerd Font Mono' font='14px'>󰤨</span>",
    "format-ethernet": "<span font_family='JetBrainsMono Nerd Font Mono' font='14px'>󰈀</span>",
    "format-disconnected": "<span font_family='JetBrainsMono Nerd Font Mono' font='14px'>󰤭</span>",
    "tooltip-format": " {ifname} via {gwaddri}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "  {ifname} ({ipaddr}/{cidr})",
    "tooltip-format-disconnected": "⚠  Disconnected",
    "on-click": "~/.config/waybar/scripts/wifi-menu.sh"
  },
  "pulseaudio": {
    "format": "<span font_family='JetBrainsMono Nerd Font Mono' font='14px'>{icon}</span> {volume}%",
    "format-bluetooth": "<span font_family='JetBrainsMono Nerd Font Mono' font='14px'>{icon}</span> {volume}%",
    "format-muted": "<span font_family='JetBrainsMono Nerd Font Mono' font='14px'>󰝟</span> muted",
    "format-icons": {
      "headphones": "󰋋",
      "handsfree": "󰋎",
      "headset": "󰋎",
      "phone": "󰏲",
      "portable": "󰏲",
      "car": "󰄋",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },
  "custom/power": {
    "format": "<span font_family='JetBrainsMono Nerd Font Mono' font='14px'>󰐥</span>",
    "on-click": "~/.config/rofi/powermenu/powermenu.sh",
    "tooltip": false
  },
  "custom/launcher": {
    "format": "<span font_family='JetBrainsMono Nerd Font Mono' font='14px'>󰋜</span>",
    "on-click": "~/.config/rofi/launchers/launcher.sh",
    "tooltip": false
  },
  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "●",
      "default": "●"
    }
  },
  "niri/language": {
    "format": "<span font_family='JetBrainsMono Nerd Font Mono' font='14px'>󰗊</span> {short}",
    "on-click": "niri msg action switch-layout next"
  },
  "custom/batmode": {
    "exec": "~/.config/waybar/scripts/battery-mode.sh",
    "return-type": "json",
    "interval": 30,
    "signal": 11,
    "on-click": "~/.config/waybar/scripts/battery-menu.sh"
  },
  "custom/arabic-kb": {
    "format": "<span font_family='JetBrainsMono Nerd Font Mono' font='14px'>󰌌</span>",
    "tooltip": true,
    "tooltip-format": "Arabic keyboard (Super+Alt+K)",
    "on-click": "~/.local/bin/arabic-keyboard-toggle"
  },
  "group/traybox": {
    "orientation": "inherit",
    "modules": [
      "tray",
      "custom/arabic-kb"
    ]
  }
}
