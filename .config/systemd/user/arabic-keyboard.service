[Unit]
Description=Arabic on-screen keyboard (hidden until toggled with Super+Alt+K)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/wvkbd-arabicpc --hidden -H 280 -L 280 --fn "Sans 18"
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target
