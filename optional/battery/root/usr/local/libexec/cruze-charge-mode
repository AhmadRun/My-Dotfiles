#!/usr/bin/python3
"""Fixed battery charge profiles; no arbitrary path or command arguments."""
import json,sys,os
from pathlib import Path
BAT=Path('/sys/class/power_supply/BAT0')
STATE=Path('/var/lib/cruze-charge-mode/profile')
PROFILES={'full':(95,100),'balanced':(70,80)}
def read():
 return {'supported': all((BAT/n).exists() for n in ['charge_control_start_threshold','charge_control_end_threshold']), 'start':int((BAT/'charge_control_start_threshold').read_text()),'end':int((BAT/'charge_control_end_threshold').read_text()),'percent':int((BAT/'capacity').read_text()),'status':(BAT/'status').read_text().strip()}
def apply(start,end):
 # Widen bounds first so every intermediate pair is valid.
 (BAT/'charge_control_end_threshold').write_text('100')
 (BAT/'charge_control_start_threshold').write_text(str(start))
 (BAT/'charge_control_end_threshold').write_text(str(end))
mode=sys.argv[1] if len(sys.argv)==2 else ''
try:
 if mode=='status':print(json.dumps(read()));sys.exit(0)
 if mode=='restore':
  if not STATE.exists():sys.exit(0)
  mode=STATE.read_text().strip()
 if mode not in PROFILES:raise ValueError('Expected status, full, balanced or restore')
 if os.geteuid()!=0:raise PermissionError('Administrator authorization required')
 previous=read();start,end=PROFILES[mode]
 try:
  apply(start,end)
  actual=read()
  if (actual['start'],actual['end'])!=(start,end):raise RuntimeError('Battery did not accept limits')
 except Exception:
  apply(previous['start'],previous['end']);raise
 STATE.parent.mkdir(mode=0o755,exist_ok=True)
 temp=STATE.with_suffix('.tmp');temp.write_text(mode+'\n');temp.chmod(0o644);temp.replace(STATE)
 print(json.dumps(actual))
except Exception as e:print(str(e),file=sys.stderr);sys.exit(1)
